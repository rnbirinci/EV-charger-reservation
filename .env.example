# Copy to .env and fill in real values. .env is gitignored.

# --- Postgres ---
POSTGRES_USER=suhube
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=suhube

# --- Backend ---
# A long random value. Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret

# --- First admin (superadmin) ---
# On first login this plate is taken straight to "set your PIN" — no password
# is stored anywhere. Use the site manager's real plate in production.
ADMIN_PLATE=34ABC000
ADMIN_NAME=Site Yönetimi
